# FlowFetch Backend Environment Variables

# Port assigned by hosting provider (defaults to 3000)
PORT=3000
NODE_ENV=production

# Frontend URL(s) allowed by CORS. Supports comma-separated domains:
# Example: https://flowfetch.pages.dev,http://localhost:5173
FRONTEND_URL=https://flowfetch.pages.dev

# Temporary storage directory (use /tmp/flowfetch on Linux containers/Render)
TEMP_DIR=/tmp/flowfetch

# Maximum file size in bytes (defaults to 2GB)
MAX_FILE_SIZE=2147483648

# Maximum job retention / cleanup timeout in ms (1 hour)
DOWNLOAD_TIMEOUT=3600000

# Rate limiting window in ms (15 minutes) and max requests per window
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Optional explicit paths to yt-dlp and ffmpeg binaries if not in PATH
# YTDLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/bin/ffmpeg
